# Runtime
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database and queue
DATABASE_URL=postgresql+psycopg://chaseless:chaseless@postgres:5432/chaseless
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Security and demo auth
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token
FIELD_ENCRYPTION_KEY=
DEMO_AUTH_ENABLED=true
DEMO_ADMIN_EMAIL=demo@chaseless.local
DEMO_ADMIN_PASSWORD_HASH=
REVIEWER_MASK_PII=true

# Razorpay Test Mode (server-side only)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com

# LLM adapter (optional for deterministic P0 paths)
LLM_PROVIDER=disabled
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
LLM_FALLBACK_PROVIDER=disabled
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CALLS_PER_RUN=25

# Policy defaults
DEFAULT_MERCHANT_TIMEZONE=Asia/Kolkata
DEFAULT_ATTRIBUTION_WINDOW_HOURS=72
DEFAULT_RECOVERY_BUDGET_MINOR=100000
DEFAULT_CONTACT_BUDGET=100
MAX_REPLANS_PER_CASE=3

# Optional channels
MESSAGING_PROVIDER=mock
MESSAGING_API_KEY=
VOICE_PROVIDER=mock
VOICE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TEST_TO=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_VOICE_FROM=
TWILIO_VOICE_TEST_TO=
TWILIO_SMS_FROM=
TWILIO_SMS_TEST_TO=
TWILIO_SMS_TEMPLATE=sms_appointment_reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TEST_TO=
SARVAM_API_KEY=

# Evaluation and observability
EVALUATION_OUTPUT_DIR=evaluation/results
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
